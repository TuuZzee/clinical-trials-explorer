# Model-backed visualizations require a key; health and the public adapter do not.
REQUEST_TIMEOUT_SECONDS=120
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000
CTGOV_TIMEOUT_SECONDS=20
CTGOV_PAGE_SIZE=100
CTGOV_MAX_PAGES=50
CTGOV_MAX_STUDIES=5000
CTGOV_MAX_RETRIES=2
CTGOV_BACKOFF_SECONDS=0.5
CTGOV_MAX_RETRY_DELAY_SECONDS=5

# Optional exact-source evidence; limits never affect ordinary requests.
CITATION_MAX_REFERENCES=1000
CITATION_MAX_BYTES=1000000
