{
  "name": "clinical-trials-explorer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "playwright test",
    "format": "prettier --check ."
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "cytoscape": "3.34.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/cytoscape": "3.21.9",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  },
  "type": "module"
}
